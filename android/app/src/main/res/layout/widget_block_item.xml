<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@android:color/white">

    <!-- Text column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/block_project_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1D1B20"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/block_time_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#49454F"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Completion badge (visible when completed) -->
    <TextView
        android:id="@+id/block_completion_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:background="#7965AF"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Complete button (visible when not yet completed) -->
    <ImageButton
        android:id="@+id/block_complete_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/checkbox_off_background"
        android:background="@android:color/transparent"
        android:contentDescription="Complete block"
        android:visibility="visible" />

</LinearLayout>
